	},
	"item": [
		{
			"name": "1. Auth",
			"item": [
				{
					"name": "Login / Register by Device ID",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"deviceId\": \"test-device-uuid-123456\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/auth/login",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"auth",
								"login"
							]
						},
						"description": "Authenticates a user by their unique device ID. If the user does not exist, a new user account is created. Returns an `access_token` and sets an Authorization cookie. Copy the token to your collection variables."
					},
					"response": []
				}
			]
		},
		{
